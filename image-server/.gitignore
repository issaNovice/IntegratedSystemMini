# ==============================
# Root-level gitignore for DVD Rental App
# ==============================

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# Cache
.cache/
coverage/
*.cache

# Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# System
*.bak
*.tmp

# React specific
frontend/.vite/
frontend/.next/
frontend/.parcel-cache/
frontend/.eslintcache

# Express specific
backend/debug.log

# Image server cache
image-server/temp/
