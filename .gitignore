# ===============================
# Global Git Ignore for DVD Rental Website
# ===============================

# Node dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/

# Logs and temp files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Cache and coverage
.cache/
coverage/
*.cache
*.pid
*.seed
*.pid.lock

# Editor and OS-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary backups
*.bak
*.tmp

# Tailwind / PostCSS cache
frontend/.eslintcache
frontend/.postcssrc
frontend/.tailwindcss-cache

# Vite and React build artifacts
frontend/.vite/
frontend/dist/
frontend/build/

# Backend specific
backend/debug.log
backend/temp/
backend/uploads/

# Image server uploads (local files)
image-server/temp/

# Misc
*.env.backup
*.log.old
